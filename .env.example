# =============================================================================
# Cerebro (CodeRAG) Backend — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit a .env file containing real secrets.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Project URL from the Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role key (preferred).  Used for server-side operations.
# Find it in Supabase dashboard → Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Legacy anon/public key (fallback if SUPABASE_SERVICE_ROLE_KEY is absent).
# Not recommended for new deployments; set SUPABASE_SERVICE_ROLE_KEY instead.
# SUPABASE_KEY=your-supabase-anon-key-here

# --- Hugging Face (required) -------------------------------------------------
# API token from https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-api-token-here

# --- CORS (required in production) -------------------------------------------
# Comma-separated list of EXACT allowed origins.  Must be HTTPS for
# non-localhost origins.  Wildcards are never permitted.
#
# Example — single production origin:
#   CORS_ALLOWED_ORIGINS=https://cerebro-delta-silk.vercel.app
#
# Example — production + one preview deployment (requires explicit review):
#   CORS_ALLOWED_ORIGINS=https://cerebro-delta-silk.vercel.app,https://cerebro-git-feature-xyz.vercel.app
#
# Development default (applied when this variable is absent):
#   http://localhost:5173, http://localhost:3000
#
CORS_ALLOWED_ORIGINS=https://cerebro-delta-silk.vercel.app

# --- Environment / deployment mode -------------------------------------------
# Set to "true" to enforce strict startup validation in production.
# The server will refuse to start if required credentials are missing or
# contain placeholder values.
PRODUCTION=false

# Alternative production flags (any one of these enables strict mode):
# CEREBRO_ENV=production
# APP_ENV=production

# --- Optional server configuration -------------------------------------------
# Local filesystem path where cloned repository data is stored.
REPOS_PATH=./coderag-data

# uvicorn bind address and port.
HOST=0.0.0.0
PORT=8000

# LLM model served via Hugging Face Inference API.
# Default: meta-llama/Llama-3.1-8B-Instruct
# CEREBRO_MODEL=meta-llama/Llama-3.1-8B-Instruct
